"},{"n":1992,"sh":"shard7","id":"763258241","pid":"30132711","ph":"ผมเสพแต่เรื่องส่วนตัวไม่เสพผลงาน","ko":"난 작품 말고 개인 사생활/가십만 챙겨봄","cat":"기타","tone":"속어","title":"ดึ๊บ ดึ๊บ 2025","creator":"","url":"https://store.line.me/stickershop/product/30132711/th","img":"data:image/jpeg;base64,"},{"n":1993,"sh":"shard7","id":"763258242","pid":"30132711","ph":"จะไม่ตัดสินใครแต่จะไม่นอน","ko":"아무도 판단 안 하겠지만 일단 잠은 안 잘래","cat":"일상","tone":"친근","title":"ดึ๊บ ดึ๊บ 2025","creator":"","url":"https://store.line.me/stickershop/product/30132711/th","img":"data:image/jpeg;base64,"},{"n":1994,"sh":"shard7","id":"763258243","pid":"30132711","ph":"คนไทยคนแรกที่ทำถึง","ko":"제대로 해낸 최초의 태국인","cat":"응원","tone":"속어","title":"ดึ๊บ ดึ๊บ 2025","creator":"","url":"https://store.line.me/stickershop/product/30132711/th","img":"data:image/jpeg;base64,"},{"n":1995,"sh":"shard7","id":"763258244","pid":"30132711","ph":"ไม่มีใครสนใจเราขนาดนั้น","ko":"아무도 우리한테 그 정도로 관심 없어","cat":"기타","tone":"친근","title":"ดึ๊บ ดึ๊บ 2025","creator":"","url":"https://store.line.me/stickershop/product/30132711/th","img":"data:image/jpeg;base64,"},{"n":1996,"sh":"shard7","id":"763258245","pid":"30132711","ph":"ข้างนอกฮาๆข้างในฮือๆ","ko":"겉으로는 하하(웃음), 속으로는 흑흑(오열)","cat":"일상","tone":"친근","title":"ดึ๊บ ดึ๊บ 2025","creator":"","url":"https://store.line.me/stickershop/product/30132711/th","img":"data:image/jpeg;base64,"},{"n":1997,"sh":"shard7","id":"763258247","pid":"30132711","ph":"ติดแกรม","ko":"글램한 척 / 화려한 척하기 (유행어)","cat":"장난","tone":"속어","title":"ดึ๊บ ดึ๊บ 2025","creator":"","url":"https://store.line.me/stickershop/product/30132711/th","img":"data:image/jpeg;base64,"},{"n":1998,"sh":"shard7","id":"763258248","pid":"30132711","ph":"ขอบคุณสำหรับความคิดเห็นที่จริงใจค่ะ","ko":"진심 어린 의견 감사합니다","cat":"감사","tone":"정중","title":"ดึ๊บ ดึ๊บ 2025","creator":"","url":"https://store.line.me/stickershop/product/30132711/th","img":"data:image/jpeg;base64,"},{"n":1999,"sh":"shard7","id":"763258250","pid":"30132711","ph":"ยาระงับเบียว","ko":"중2병 진정제 (헛소리 방지약)","cat":"장난","tone":"속어","title":"ดึ๊บ ดึ๊บ 2025","creator":"","url":"https://store.line.me/stickershop/product/30132711/th","img":"data:image/jpeg;base64,"},{"n":2000,"sh":"shard7","id":"763258251","pid":"30132711","ph":"ไม่รับความเห็นต่าง","ko":"다른 의견은 안 받습니다 (반론 사절)","cat":"장난","tone":"비꼼","title":"ดึ๊บ ดึ๊บ 2025","creator":"","url":"https://store.line.me/stickershop/product/30132711/th","img":"data:image/jpeg;base64,"}];const PER=100;let page=0,list=[];const $=x=>document.getElementById(x);function esc(s){return String(s??'').replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));}function apply(){const q=$('q').value.trim().toLowerCase(),cat=$('cat').value,tone=$('tone').value,sh=$('shard').value;list=DATA.filter(d=>(!q||(d.ph+' '+d.ko+' '+d.title+' '+d.creator+' '+d.id+' '+d.pid).toLowerCase().includes(q))&&(!cat||d.cat===cat)&&(!tone||d.tone===tone)&&(!sh||d.sh===sh));if(page*PER>=list.length)page=0;render();}function render(){const s=page*PER;const a=list.slice(s,s+PER);$('ct').textContent=list.length+'개 중 '+(list.length?(s+1)+'~'+Math.min(s+PER,list.length):'0')+' 표시';$('gr').innerHTML=a.map(d=>'<a class="card" target="_blank" rel="noopener" href="'+d.url+'"><span class="num">#'+d.n+'</span><div class="pic"><img src="'+d.img+'" alt=""></div><div class="body"><div class="phrase">'+esc(d.ph)+'</div><div class="meaning">'+esc(d.ko)+'</div><div class="title">'+esc(d.title)+'</div><div class="meta"><span class="tag">'+esc(d.cat||'분류없음')+'</span><span class="tag">'+esc(d.tone||'말투없음')+'</span></div><div class="meta">sticker '+esc(d.id)+' · product '+esc(d.pid)+'</div></div></a>').join('');const n=Math.ceil(list.length/PER);$('pg').innerHTML=Array.from({length:n},(_,i)=>'<button class="'+(i===page?'on':'')+'" data-p="'+i+'">'+(i*PER+1)+'~'+Math.min((i+1)*PER,list.length)+'</button>').join('');window.scrollTo(0,0);} $('pg').onclick=e=>{const b=e.target.closest('button');if(b){page=+b.dataset.p;render();}};for(const id of ['q','cat','tone','shard'])$(id).oninput=()=>{page=0;apply();};$('go').onchange=()=>{const n=+$('go').value;const i=DATA.findIndex(d=>d.n===n);if(i>=0){$('q').value='';$('cat').value='';$('tone').value='';$('shard').value='';list=DATA;page=Math.floor(i/PER);render();}};$('reset').onclick=()=>{for(const id of ['q','cat','tone','shard'])$(id).value='';page=0;apply();};apply();</script></body></html>