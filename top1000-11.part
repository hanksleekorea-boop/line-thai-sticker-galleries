","images/official_0077_13321.png":"data:image/png;base64,","images/official_0078_7494.png":"data:image/png;base64,","images/official_0079_1975.png":"data:image/png;base64,","images/official_0080_1917.png":"data:image/png;base64,","images/official_0081_1669.png":"data:image/png;base64,","images/official_0082_37767.png":"data:image/png;base64,","images/official_0083_37599.png":"data:image/png;base64,","images/official_0084_37437.png":"data:image/png;base64,","images/official_0085_37426.png":"data:image/png;base64,","images/official_0086_37383.png":"data:image/png;base64,","images/official_0087_36940.png":"data:image/png;base64,","images/official_0088_35523.png":"data:image/png;base64,","images/official_0089_32228.png":"data:image/png;base64,","images/official_0090_32114.png":"data:image/png;base64,","images/official_0091_31362.png":"data:image/png;base64,","images/official_0092_31387.png":"data:image/png;base64,","images/official_0093_29824.png":"data:image/png;base64,","images/official_0094_23873.png":"data:image/png;base64,","images/official_0095_12056.png":"data:image/png;base64,","images/official_0096_8550.png":"data:image/png;base64,","images/official_0097_8543.png":"data:image/png;base64,","images/official_0098_7776.png":"data:image/png;base64,","images/official_0099_7766.png":"data:image/png;base64,","images/official_0100_7260.png":"data:image/png;base64,"};
const PER=100;let tab='A',page=0,list=[];
const $=id=>document.getElementById(id);
const typeName={static:'정지',animation:'움직임',popup:'팝업',animation_sound:'움직임+소리',popup_sound:'팝업+소리'};
function apply(){const q=$('q').value.trim().toLowerCase(),ty=$('ty').value;list=DATA[tab].filter(d=>(!q||(d.t+' '+d.c).toLowerCase().includes(q))&&(!ty||d.y===ty));if(page*PER>=list.length)page=0;render();}
function render(){const s=page*PER,items=list.slice(s,s+PER);
$('ct').textContent=list.length+'개 중 '+(list.length?(s+1)+'~'+Math.min(s+PER,list.length):'0')+' 표시';
$('gr').innerHTML=items.map(d=>'<a class="card" target="_blank" rel="noopener" href="https://store.line.me/stickershop/product/'+d.id+'/th"><span class="rk'+(d.r<=10?' top':'')+'">'+d.r+'</span><div class="img"><img src="'+IMG[d.i]+'" alt=""></div><div class="tx"><div class="ti">'+esc(d.t)+'</div><div class="me">'+esc(d.c)+'</div><div class="me">'+esc(d.p||'')+' · '+(d.n||'?')+'개<span class="tag">'+(typeName[d.y]||d.y)+'</span></div></div></a>').join('');
const n=Math.ceil(list.length/PER);$('pg').innerHTML=Array.from({length:n},(_,i)=>'<button class="'+(i===page?'on':'')+'" data-p="'+i+'">'+(i*PER+1)+'~'+Math.min((i+1)*PER,list.length)+'</button>').join('');
window.scrollTo(0,0);}
function esc(s){return String(s).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));}
$('pg').onclick=e=>{const b=e.target.closest('button');if(b){page=+b.dataset.p;render();}};
$('q').oninput=()=>{page=0;apply();};$('ty').onchange=()=>{page=0;apply();};
$('go').onchange=()=>{const r=+$('go').value;$('q').value='';$('ty').value='';list=DATA[tab];const i=list.findIndex(d=>d.r===r);if(i>=0){page=Math.floor(i/PER);render();}};
for(const [id,t] of [['tA','A'],['tB','B']])$(id).onclick=()=>{tab=t;page=0;$('tA').classList.toggle('on',t==='A');$('tB').classList.toggle('on',t==='B');apply();};
apply();
</script></body></html>